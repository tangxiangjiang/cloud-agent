{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-agent.local/schemas/workflow-bundle.schema.json",
  "title": "WorkflowBundle",
  "description": "Design-time DAG plan under ai/bundles/*.json. Snapshot into a WorkflowRun on start.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "repoId", "nodes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "repoId": { "type": "string", "minLength": 1 },
    "preferredSlaveId": { "type": "string" },
    "progressDoc": {
      "type": "string",
      "description": "Repo-relative path updated only after App approve"
    },
    "roadmapRef": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phaseRef", "dependsOn"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "phaseRef": {
            "type": "string",
            "minLength": 1,
            "description": "Repo-relative markdown path; no .. segments"
          },
          "title": { "type": "string" },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" }
          },
          "model": { "type": "string" },
          "dodChecks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "onFailure": {
            "type": "string",
            "enum": ["stop", "skip", "retry"]
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["phase_file", "inline"]
              },
              "extra": { "type": "string" },
              "inline": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

# Copy to .env if you use a dotenv loader later. Prefer OS/shell env for secrets.
# Never commit real keys.

# Cursor Local Agent API key (value only in your shell / secret store)
CURSOR_API_KEY=

# Gateway Bearer from POST /v1/auth/pair (M04-P02+)
GATEWAY_TOKEN=

# Optional override for config file path
# SLAVE_CONFIG=./config.yaml

# Optional: npm run smoke-local overrides
# SMOKE_CWD=
# SMOKE_MODEL=composer-2.5
# SMOKE_PROMPT=
